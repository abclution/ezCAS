{
    "editor.defaultFormatter": "mikoz.composite-formatter",
    "[python]": {
        "editor.defaultFormatter": "charliermarsh.ruff"
    },
    "workbench.colorCustomizations": {
        "activityBar.background": "#212121",
        "activityBar.foreground": "#ffffff",
        "activityBar.inactiveForeground": "#a0a0a0",
        "sideBar.background": "#212121",
        "sideBar.foreground": "#e0e0e0",
        "sideBarTitle.foreground": "#ffffff",
        "statusBar.background": "#5d3a1a",
        "statusBar.foreground": "#ffffff",
        "statusBar.noFolderBackground": "#5d3a1a",
        "titleBar.activeBackground": "#595959",
        "titleBar.activeForeground": "#ffffff",
        "titleBar.inactiveBackground": "#595959",
        "titleBar.inactiveForeground": "#a0a0a0",
        "panel.background": "#212118",
        "panel.border": "#212121"
    },
    "python-hover.onlineDiscovery": true,
    "python-hover.ui.showCallouts": false,
    "python-hover.ui.contextMenu.debugPinHover": false,
    "python-hover.ui.showSignatures": false,
    "python-hover.ui.maxExamples": 4,
    "python-hover.ui.moduleBrowser.defaultDensity": "compact",
    "python-hover.ui.showSeeAlso": false,
    "python-hover.ui.showRaises": false,
    "git.autoRepositoryDetection": false,
    "git.repositoryScanIgnoredFolders": [],
    "git.repositoryScanMaxDepth": 0
}